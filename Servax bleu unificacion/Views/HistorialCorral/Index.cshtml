@model List<Servax_bleu_unificacion.Models.HistorialCorral>
@{
    ViewBag.Title = "Historial de Corrales";
}

<div class="container-fluid px-4 mt-4">

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Historial de Corrales</h4>
        <a href="@Url.Action("Create")" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Nuevo Snapshot
        </a>
    </div>

    <div class="alert alert-info small">
        <i class="fa-solid fa-circle-info me-1"></i>
        Este historial es una bit&aacute;cora peri&oacute;dica (foto del estado de un corral en un momento dado), no se edita
        solo se agregan nuevos registros o se eliminan los que est&eacute;n mal capturados.
    </div>

    <form method="get" class="row g-2 mb-3">
        <div class="col-auto">
            <select name="idCorral" class="form-select" onchange="this.form.submit()">
                <option value="">Todos los corrales</option>
                @foreach (var c in (List<SelectListItem>)ViewBag.Corrales)
                {
                    <option value="@c.Value" selected="@(ViewBag.IdCorralFiltro != null && ViewBag.IdCorralFiltro.ToString() == c.Value)">@c.Text</option>
                }
            </select>
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha</th>
                        <th>Corral</th>
                        <th>Cantidad Peces</th>
                        <th>Estado General</th>
                        <th>Resumen Calidad Agua</th>
                        <th>Resumen Nutrientes</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var h in Model)
                        {
                            <tr>
                                <td>@h.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="fw-semibold">@h.NombreCorral</td>
                                <td>@h.CantidadPeces</td>
                                <td>@(h.EstadoGeneral ?? "-")</td>
                                <td class="text-muted small">@(h.ResumenCalidadAgua ?? "-")</td>
                                <td class="text-muted small">@(h.ResumenNutrientes ?? "-")</td>
                                <td class="text-end">
                                    <a href="@Url.Action("Delete", new { id = h.IdHistorial })" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="fa-solid fa-trash"></i></a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No hay historial registrado todav&iacute;a.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
