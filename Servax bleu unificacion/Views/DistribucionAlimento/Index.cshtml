@model List<Servax_bleu_unificacion.Models.DistribucionAlimento>
@{
    ViewBag.Title = "Distribucion de Carnada";
}

<div class="container-fluid px-4 mt-4">

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0"><i class="fa-solid fa-ship text-primary me-2"></i>Distribuci&oacute;n de Carnada</h4>
        <a href="@Url.Action("Distribuir")" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-scale-balanced me-1"></i> Distribuir Carnada
        </a>
    </div>

    <div class="alert alert-warning small">
        <i class="fa-solid fa-circle-info me-1"></i>
        La f&oacute;rmula de distribuci&oacute;n usada es un <strong>placeholder proporcional a la capacidad de cada barco</strong>
        todav&iacute;a no est&aacute; confirmada por el cliente. Se puede ver en la columna "F&oacute;rmula aplicada" de cada registro.
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha</th>
                        <th>Barco</th>
                        <th>Corral destino</th>
                        <th>Alimento</th>
                        <th>Toneladas</th>
                        <th>F&oacute;rmula aplicada</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var d in Model)
                        {
                            <tr>
                                <td>@d.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="fw-semibold">@d.NombreBarco</td>
                                <td>@d.NombreCorral</td>
                                <td>@d.NombreAlimento</td>
                                <td>@d.CantidadToneladas.ToString("N2")</td>
                                <td class="text-muted small">@d.FormulaAplicada</td>
                                <td class="text-end">
                                    <a href="@Url.Action("Delete", new { id = d.IdDistribucion })" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No hay distribuciones registradas todav&iacute;a.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
