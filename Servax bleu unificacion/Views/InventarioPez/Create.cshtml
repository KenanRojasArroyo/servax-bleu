@model Servax_bleu_unificacion.Models.InventarioPez
@{
    ViewBag.Title = "Nuevo Registro de Inventario";
}

<div class="container-fluid px-4 mt-4">
    <h4 class="fw-bold mb-4"><i class="fa-solid fa-plus text-primary me-2"></i>Nuevo Registro de Inventario</h4>

    <div class="card shadow-sm border-0" style="max-width: 700px;">
        <div class="card-body p-4">
            @using (Html.BeginForm("Create", "InventarioPez", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Corral *</label>
                        @Html.DropDownListFor(m => m.IdCorral, (List<SelectListItem>)ViewBag.Corrales, "-- Selecciona --", new { @class = "form-select" })
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Especie *</label>
                        @Html.DropDownListFor(m => m.IdEspecie, (List<SelectListItem>)ViewBag.Especies, "-- Selecciona --", new { @class = "form-select" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Cantidad *</label>
                        @Html.TextBoxFor(m => m.Cantidad, new { @class = "form-control", type = "number" })
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Peso Promedio (kg)</label>
                        @Html.TextBoxFor(m => m.PesoPromedioKg, new { @class = "form-control", type = "number", step = "0.01" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Estado</label>
                        @Html.DropDownListFor(m => m.Estado, new List<SelectListItem>
                        {
                            new SelectListItem { Text = "Saludable", Value = "Saludable" },
                            new SelectListItem { Text = "En observación", Value = "En observación" },
                            new SelectListItem { Text = "Enfermo", Value = "Enfermo" }
                        }, "-- Selecciona --", new { @class = "form-select" })
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Fecha de Registro</label>
                        @Html.TextBoxFor(m => m.FechaRegistro, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold">Observaciones</label>
                    @Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control", rows = 2 })
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary shadow-sm"><i class="fa-solid fa-floppy-disk me-1"></i> Guardar</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            }
        </div>
    </div>
</div>
