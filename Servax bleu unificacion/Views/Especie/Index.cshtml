@model List<Servax_bleu_unificacion.Models.Especie>
@{
    ViewBag.Title = "Especies";
}

<div class="container-fluid px-4 mt-4">

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0"><i class="fa-solid fa-fish text-primary me-2"></i>Especies</h4>
        <a href="@Url.Action("Create")" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Nueva Especie
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Nombre Cient&iacute;fico</th>
                        <th>Tipo</th>
                        <th>T&oacute;xica</th>
                        <th>Activo</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var especie in Model)
                        {
                            <tr class="@(especie.EsToxica ? "table-warning" : "")">
                                <td class="fw-semibold">@especie.Nombre</td>
                                <td class="fst-italic">@especie.NombreCientifico</td>
                                <td>@especie.Tipo</td>
                                <td>
                                    @if (especie.EsToxica)
                                    {
                                        <span class="badge rounded-pill bg-danger">
                                            <i class="fa-solid fa-skull-crossbones me-1"></i>T&oacute;xica
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-success">No</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-@(especie.Activo ? "primary" : "secondary")">
                                        @(especie.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a href="@Url.Action("Details", new { id = especie.IdEspecie })" class="btn btn-sm btn-outline-secondary" title="Ver">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = especie.IdEspecie })" class="btn btn-sm btn-outline-primary" title="Editar">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = especie.IdEspecie })" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No hay especies registradas todav&iacute;a.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
