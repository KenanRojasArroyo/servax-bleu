@model List<Servax_bleu_unificacion.Models.RegistroAlimentacion>
@{
    ViewBag.Title = "Registro de Alimentación";
}

<div class="container-fluid px-4 mt-4">

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h4 class="fw-bold mb-0"><i class="fa-solid fa-utensils text-primary me-2"></i>Registro de Alimentación</h4>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Mortalidad", "Reporte")" class="btn btn-outline-danger shadow-sm">
                <i class="fa-solid fa-chart-column me-1"></i> Ver Reporte de Mortalidad
            </a>
            <a href="@Url.Action("Create")" class="btn btn-primary shadow-sm">
                <i class="fa-solid fa-plus me-1"></i> Nuevo Registro
            </a>
        </div>
    </div>

    <form method="get" class="row g-2 mb-3">
        <div class="col-auto">
            <select name="idCorral" class="form-select" onchange="this.form.submit()">
                <option value="">Todos los corrales</option>
                @foreach (var c in (List<SelectListItem>)ViewBag.Corrales)
                {
                    <option value="@c.Value" selected="@(ViewBag.IdCorralFiltro != null && ViewBag.IdCorralFiltro.ToString() == c.Value)">@c.Text</option>
                }
            </select>
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha</th>
                        <th>Corral</th>
                        <th>Alimento</th>
                        <th>Cantidad (kg)</th>
                        <th>Responsable</th>
                        <th>Mortalidad</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var r in Model)
                        {
                            <tr class="@(r.Mortalidad > 0 ? "table-danger" : "")">
                                <td>@r.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="fw-semibold">@r.NombreCorral</td>
                                <td>@r.NombreAlimento</td>
                                <td>@r.CantidadKg.ToString("N2")</td>
                                <td>@(r.Responsable ?? "-")</td>
                                <td>@(r.Mortalidad > 0 ? r.Mortalidad.ToString() : "-")</td>
                                <td class="text-end">
                                    <a href="@Url.Action("Edit", new { id = r.IdRegistro })" class="btn btn-sm btn-outline-primary" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                    <a href="@Url.Action("Delete", new { id = r.IdRegistro })" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="fa-solid fa-trash"></i></a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No hay registros de alimentación todavía.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
