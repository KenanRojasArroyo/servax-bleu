@model List<Servax_bleu_unificacion.Models.Alimento>
@{
    ViewBag.Title = "Alimentos";
}

<div class="container-fluid px-4 mt-4">

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0"><i class="fa-solid fa-drumstick-bite text-primary me-2"></i>Alimentos</h4>
        <a href="@Url.Action("Create")" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Nuevo Alimento
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Unidad</th>
                        <th>Stock Actual</th>
                        <th>Costo Unitario</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var a in Model)
                        {
                            <tr class="@(a.StockActual <= 0 ? "table-warning" : "")">
                                <td class="fw-semibold">@a.Nombre</td>
                                <td>@(a.TipoAlimento ?? "-")</td>
                                <td>@(a.UnidadMedida ?? "-")</td>
                                <td>@a.StockActual.ToString("N2")</td>
                                <td>@a.CostoUnitario.ToString("C2")</td>
                                <td class="text-end">
                                    <a href="@Url.Action("Edit", new { id = a.IdAlimento })" class="btn btn-sm btn-outline-primary" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                    <a href="@Url.Action("Delete", new { id = a.IdAlimento })" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="fa-solid fa-trash"></i></a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No hay alimentos registrados todavía.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
