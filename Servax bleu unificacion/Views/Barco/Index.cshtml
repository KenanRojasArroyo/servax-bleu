@model List<Servax_bleu_unificacion.Models.Barco>
@{
    ViewBag.Title = "Barcos";
}

<div class="container-fluid px-4 mt-4">

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0"><i class="fa-solid fa-ship text-primary me-2"></i>Barcos</h4>
        <a href="@Url.Action("Create")" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Nuevo Barco
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Capacidad (ton)</th>
                        <th>Estado</th>
                        <th>Fecha de Alta</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var b in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@b.Nombre</td>
                                <td>@b.CapacidadToneladas.ToString("N2")</td>
                                <td><span class="badge rounded-pill bg-@(b.Estado == "Activo" ? "success" : "secondary")">@(b.Estado ?? "-")</span></td>
                                <td>@(b.FechaAlta?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="text-end">
                                    <a href="@Url.Action("Edit", new { id = b.IdBarco })" class="btn btn-sm btn-outline-primary" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                    <a href="@Url.Action("Delete", new { id = b.IdBarco })" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="fa-solid fa-trash"></i></a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No hay barcos registrados todavía.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
