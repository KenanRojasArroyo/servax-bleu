@model Servax_bleu_unificacion.Models.Barco
@{
    ViewBag.Title = "Editar Barco";
}

<div class="container-fluid px-4 mt-4">
    <h4 class="fw-bold mb-4"><i class="fa-solid fa-pen text-primary me-2"></i>Editar Barco</h4>

    <div class="card shadow-sm border-0" style="max-width: 700px;">
        <div class="card-body p-4">
            @using (Html.BeginForm("Edit", "Barco", new { id = Model.IdBarco }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IdBarco)
                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                <div class="mb-3">
                    <label class="form-label fw-bold">Nombre *</label>
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Capacidad (toneladas) *</label>
                        @Html.TextBoxFor(m => m.CapacidadToneladas, new { @class = "form-control", type = "number", step = "0.01" })
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Fecha de Alta</label>
                        @Html.TextBoxFor(m => m.FechaAlta, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Estado</label>
                    @Html.DropDownListFor(m => m.Estado, new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Activo", Value = "Activo" },
                        new SelectListItem { Text = "Inactivo", Value = "Inactivo" },
                        new SelectListItem { Text = "En mantenimiento", Value = "En mantenimiento" }
                    }, new { @class = "form-select" })
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold">Observaciones</label>
                    @Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control", rows = 2 })
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary shadow-sm"><i class="fa-solid fa-floppy-disk me-1"></i> Guardar Cambios</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            }
        </div>
    </div>
</div>
