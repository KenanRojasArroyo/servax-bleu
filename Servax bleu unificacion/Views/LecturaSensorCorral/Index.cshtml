@model List<Servax_bleu_unificacion.Models.LecturaSensorCorral>
@{
    ViewBag.Title = "Lecturas de Sensores";
}

<div class="container-fluid px-4 mt-4">

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h4 class="fw-bold mb-0"><i class="fa-solid fa-temperature-half text-primary me-2"></i>Lecturas de Sensores por Corral</h4>
        <a href="@Url.Action("Create", new { idCorral = ViewBag.IdCorralFiltro })" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Nueva Lectura
        </a>
    </div>

    <!-- Filtro por corral -->
    <form method="get" class="row g-2 mb-3">
        <div class="col-auto">
            <select name="idCorral" class="form-select" onchange="this.form.submit()">
                <option value="">Todos los corrales</option>
                @foreach (var c in (List<SelectListItem>)ViewBag.Corrales)
                {
                    <option value="@c.Value" selected="@(ViewBag.IdCorralFiltro != null && ViewBag.IdCorralFiltro.ToString() == c.Value)">@c.Text</option>
                }
            </select>
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Corral</th>
                        <th>Fecha</th>
                        <th>Profundidad</th>
                        <th>M&eacute;todo</th>
                        <th>Sensor</th>
                        <th>Temp. (&deg;C)</th>
                        <th>Ox&iacute;geno (mg/L)</th>
                        <th>Saturaci&oacute;n O&#8322; (%)</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var l in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@l.NombreCorral</td>
                                <td>@l.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@l.Profundidad.ToString("0.#") m</td>
                                <td>
                                    @if (l.MetodoCaptura == "Sensor")
                                    {
                                        <span class="badge bg-info text-dark"><i class="fa-solid fa-satellite-dish me-1"></i>Sensor</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="fa-solid fa-hand me-1"></i>Manual</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrEmpty(l.NumeroSensor) ? "—" : (l.MarcaSensor + " " + l.NumeroSensor))</td>
                                <td>@(l.Temperatura.HasValue ? l.Temperatura.Value.ToString("N1") : "-")</td>
                                <td>@(l.OxigenoMgL.HasValue ? l.OxigenoMgL.Value.ToString("N2") : "-")</td>
                                <td>@(l.SaturacionOxigenoPct.HasValue ? l.SaturacionOxigenoPct.Value.ToString("N1") : "-")</td>
                                <td class="text-end text-nowrap">
                                    <a href="@Url.Action("Edit", new { id = l.IdLectura })" class="btn btn-sm btn-outline-primary" title="Editar">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = l.IdLectura })" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">No hay lecturas registradas todav&iacute;a.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
