@model Servax_bleu_unificacion.Models.LecturaSensorCorral
@{
    ViewBag.Title = "Eliminar Lectura de Sensor";
}

<div class="container-fluid px-4 mt-4">
    <h4 class="fw-bold mb-4 text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>Eliminar Lectura de Sensor</h4>

    <div class="card shadow-sm border-0" style="max-width: 700px;">
        <div class="card-body p-4">
            <p class="mb-4">
                ¿Seguro que quieres eliminar la lectura <strong>@Model.MetodoCaptura</strong> del corral
                <strong>@Model.NombreCorral</strong> del <strong>@Model.Fecha.ToString("dd/MM/yyyy")</strong>
                a <strong>@Model.Profundidad.ToString("0.#") m</strong> de profundidad?
            </p>

            @using (Html.BeginForm("Delete", "LecturaSensorCorral", new { id = Model.IdLectura }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger shadow-sm"><i class="fa-solid fa-trash me-1"></i> Sí, eliminar</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            }
        </div>
    </div>
</div>
