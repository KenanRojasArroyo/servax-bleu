@model System.Data.DataTable
@{
    ViewBag.Title = "Monitoreo de Calidad";
}

<div class="container-fluid px-4 mt-4">
    <div class="row g-4">

        <!-- COLUMNA IZQUIERDA: DASHBOARD Y DATOS -->
        <div class="col-lg-8">

            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4">
                    <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Selector de Rango de Fechas -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body bg-light rounded-3 p-3">
                    @using (Html.BeginForm("ObtenerCalidad", "Home", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
                    {
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-secondary mb-1">Fecha Inicio</label>
                            <input type="date" name="fechaInicio" class="form-control" value="@ViewBag.FechaInicio" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-secondary mb-1">Fecha Fin</label>
                            <input type="date" name="fechaFin" class="form-control" value="@ViewBag.FechaFin" />
                        </div>
                        <div class="col-md-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary w-100 shadow-sm">
                                <i class="fa-solid fa-filter me-1"></i> Filtrar
                            </button>
                            <a href="@Url.Action("ObtenerCalidad", "Home")" class="btn btn-outline-secondary" title="Limpiar filtro">
                                <i class="fa-solid fa-rotate-left"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Canvas de la Gráfica Interactiva -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="fw-bold mb-0"><i class="fa-solid fa-chart-line text-info me-2"></i>Gráfica Comparativa de Parámetros</h5>
                    <span class="badge bg-info text-dark" id="lblTotalRegistros">0 lecturas</span>
                </div>
                <div class="card-body">
                    <div style="position: relative; height: 320px;">
                        <canvas id="graficaCalidad"></canvas>
                    </div>
                </div>
            </div>

            <!-- Tabla con datos -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-table me-2"></i>Registros Guardados</h5>
                    <button type="button" id="btnAbrirImportar" class="sv-upload-trigger">
                        <i class="fa-solid fa-file-excel"></i> Importar Excel
                    </button>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Fecha</th>
                                <th>Temperatura (°C)</th>
                                <th>Oxígeno (mg/L)</th>
                                <th>Profundidad (m)</th>
                            </tr>
                        </thead>
                        <tbody id="tablaBody">
                            @if (Model != null && Model.Rows.Count > 0)
                            {
                                foreach (System.Data.DataRow row in Model.Rows)
                                {
                                    <tr>
                                        <td>@row["id"]</td>
                                        <td>@(row["Fecha"] != DBNull.Value ? Convert.ToDateTime(row["Fecha"]).ToString("dd/MM/yyyy") : "-")</td>
                                        <td>@row["Temperatura"]</td>
                                        <td>@row["Oxigeno"]</td>
                                        <td>@row["Profundidad"]</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        No se encontraron registros para el rango seleccionado.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

        <!-- COLUMNA DERECHA: ASISTENTE DE DATOS (estilo Apple) -->
        <div class="col-lg-4">
            <div class="sv-panel sticky-top" style="top: 20px; z-index: 100;">

                <!-- Encabezado minimal -->
                <div class="sv-panel-header">
                    <span class="sv-eyebrow">Asistente de datos</span>
                    <h6 class="sv-title">Consulta natural</h6>
                    <p class="sv-subtitle">Describe lo que buscas y el panel se actualiza al instante.</p>
                </div>

                <!-- Campo de consulta estilo Spotlight -->
                <div class="sv-searchbar">
                    <i class="fa-solid fa-sparkles sv-searchbar-icon"></i>
                    <input type="text" id="copilotInput" class="sv-searchbar-input" placeholder="Ej. Muestra las lecturas de hoy" autocomplete="off" />
                    <button type="button" id="btnEnviarCopilot" class="sv-searchbar-btn" aria-label="Enviar consulta" disabled>
                        <i class="fa-solid fa-arrow-up"></i>
                    </button>
                </div>

                <!-- Sugerencias rápidas -->
                <div class="sv-chips" id="copilotChips">
                    <button type="button" class="sv-chip" data-query="Muestra las lecturas de hoy">Lecturas de hoy</button>
                    <button type="button" class="sv-chip" data-query="Temperaturas superiores a 21°C">Temp &gt; 21°C</button>
                    <button type="button" class="sv-chip" data-query="Oxígeno menor a 5">Oxígeno &lt; 5</button>
                </div>

                <!-- Ficha de resultado -->
                <div id="copilotResultado" class="sv-result-empty">
                    <i class="fa-regular fa-comment-dots"></i>
                    <p>Aún no has hecho ninguna consulta.</p>
                </div>

                <!-- Historial reciente -->
                <div id="copilotHistorial" class="sv-history"></div>

            </div>
        </div>

    </div>
</div>

<!-- Modal de importación (estilo Google Drive) -->
<div id="uploadModalOverlay" class="sv-modal-overlay" hidden>
    <div class="sv-modal" role="dialog" aria-modal="true" aria-labelledby="uploadModalTitle">
        <div class="sv-modal-header">
            <h5 id="uploadModalTitle" class="sv-modal-title">Importar lecturas desde Excel</h5>
            <button type="button" id="btnCerrarImportar" class="sv-modal-close" aria-label="Cerrar">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        @using (Html.BeginForm("CargarExcel", "Home", FormMethod.Post, new { enctype = "multipart/form-data", id = "uploadForm" }))
        {
            <div id="dropZone" class="sv-dropzone">
                <div class="sv-dropzone-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
                <p class="sv-dropzone-title">Arrastra tu archivo aquí</p>
                <p class="sv-dropzone-subtitle">o haz clic para buscarlo en tu equipo &middot; .xlsx, .xls</p>
                <input type="file" id="archivoExcel" name="archivoExcel" accept=".xlsx, .xls" class="d-none" />
            </div>

            <div id="fileInfo" class="sv-file-row d-none">
                <div class="sv-file-info">
                    <i class="fa-solid fa-file-excel"></i>
                    <span id="fileName"></span>
                </div>
                <div class="sv-file-actions">
                    <button type="button" id="btnQuitarArchivo" class="sv-btn-ghost">Quitar</button>
                    <button type="submit" class="sv-btn-primary">Guardar en SQL</button>
                </div>
            </div>
        }
    </div>
</div>

<style>
    :root {
        --sv-ink: #1D1D1F;
        --sv-secondary: #6E6E73;
        --sv-hairline: #E5E5EA;
        --sv-surface: #FBFBFD;
        --sv-accent: #0C8599;
        --sv-accent-dark: #086D7D;
        --sv-accent-tint: rgba(12, 133, 153, 0.08);
        --sv-danger: #D64545;
        --sv-danger-tint: rgba(214, 69, 69, 0.08);
        --sv-success: #2FA84F;
        /* Tipografía: familia única del sistema, la jerarquía la marcan peso y tamaño (como en el HIG de Apple) */
        --sv-font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Helvetica, Arial, sans-serif;
        /* Escala de espaciado (múltiplos de 4px) */
        --sv-space-1: 4px;
        --sv-space-2: 8px;
        --sv-space-3: 12px;
        --sv-space-4: 16px;
        --sv-space-5: 24px;
        --sv-space-6: 32px;
        /* Escala de radios */
        --sv-radius-sm: 12px;
        --sv-radius-md: 18px;
        --sv-radius-lg: 26px;
        --sv-radius-pill: 999px;
    }

    .sv-panel {
        background: #FFFFFF;
        border-radius: var(--sv-radius-lg);
        border: 1px solid var(--sv-hairline);
        box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 12px 28px rgba(0,0,0,0.06);
        padding: var(--sv-space-5);
        font-family: var(--sv-font);
        color: var(--sv-ink);
    }

    .sv-panel-header {
        margin-bottom: 16px;
    }

    .sv-eyebrow {
        display: inline-block;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--sv-accent);
    }

    .sv-title {
        margin: 4px 0 2px;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--sv-ink);
    }

    .sv-subtitle {
        margin: 0;
        font-size: 13px;
        color: var(--sv-secondary);
        line-height: 1.4;
    }

    /* Barra de búsqueda tipo Spotlight */
    .sv-searchbar {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--sv-surface);
        border: 1px solid var(--sv-hairline);
        border-radius: var(--sv-radius-pill);
