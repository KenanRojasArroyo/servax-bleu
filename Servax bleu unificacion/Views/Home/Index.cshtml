@model Servax_bleu_unificacion.Controllers.DashboardIndexViewModel
@{
    ViewBag.Title = "Dashboard de Monitoreo Acuícola";
}

<div class="container-fluid py-4">
    <h3 class="fw-bold mb-4 text-dark">Dashboard</h3>

    <div class="row g-4">

        <!-- Gráfica 1: Calidad vs Muestreo -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="card-title fw-bold text-muted">TENDENCIA DE CALIDAD DEL AGUA</h6>
                    <div style="position: relative; height:280px;">
                        <canvas id="chartCalidad"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráfica 2: Inventario con Especie y Corral -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="card-title fw-bold text-muted">DISTRIBUCIÓN DEL INVENTARIO (POR CORRAL Y ESPECIE)</h6>
                    <div style="position: relative; height:280px;">
                        <canvas id="chartInventario"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráfica 3: Crecimiento Anual con Especie -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="card-title fw-bold text-muted">CRECIMIENTO POR ESPECIE (KG)</h6>
                    <div style="position: relative; height:280px;">
                        <canvas id="chartCrecimiento"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráfica 4: Registro Alimentación con Inventario y Especie -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="card-title fw-bold text-muted">ALIMENTACIÓN E INVENTARIO</h6>
                    <div style="position: relative; height:280px;">
                        <canvas id="chartAlimentacion"></canvas>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // ==========================================
        // 1. DATOS GRÁFICA 1: CALIDAD CON MUESTREO AGUA
        // ==========================================
        const labelsCalidad = [];
        const datosTemp = [];
        const datosOxigeno = [];

        @if (Model != null && Model.CalidadMuestreo.Rows.Count > 0)
        {
            foreach (System.Data.DataRow row in Model.CalidadMuestreo.Rows)
            {
                var fechaStr = row["Fecha"] != DBNull.Value ? Convert.ToDateTime(row["Fecha"]).ToString("dd/MM") : "";
                <text>
                    labelsCalidad.push("@fechaStr");
                    datosTemp.push(@(row["Temperatura"] != DBNull.Value ? row["Temperatura"].ToString().Replace(',', '.') : "0"));
                    datosOxigeno.push(@(row["Oxigeno"] != DBNull.Value ? row["Oxigeno"].ToString().Replace(',', '.') : "0"));
                </text>
            }
        }

        new Chart(document.getElementById('chartCalidad'), {
            type: 'line',
            data: {
                labels: labelsCalidad,
                datasets: [
                    { label: 'Temperatura (°C)', data: datosTemp, borderColor: '#0d6efd', fill: false },
                    { label: 'Oxígeno (mg/L)', data: datosOxigeno, backgroundColor: '#dc3545', type: 'bar' }
                ]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });


        // ==========================================
        // 2. DATOS GRÁFICA 2: INVENTARIO CON ESPECIE Y CORRAL
        // ==========================================
        const labelsInventario = [];
        const datosCantidadPeces = [];

        @if (Model != null && Model.InventarioCorralEspecie.Rows.Count > 0)
        {
            foreach (System.Data.DataRow row in Model.InventarioCorralEspecie.Rows)
            {
                var labelTag = $"{row["Corral"]} - {row["Especie"]}";
                <text>
                    labelsInventario.push("@labelTag");
                    datosCantidadPeces.push(@(row["CantidadPeces"] != DBNull.Value ? row["CantidadPeces"].ToString().Replace(',', '.') : "0"));
                </text>
            }
        }

        new Chart(document.getElementById('chartInventario'), {
            type: 'bar',
            data: {
                labels: labelsInventario,
                datasets: [
                    { label: 'Cantidad de Peces', data: datosCantidadPeces, backgroundColor: '#20c997' }
                ]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });


        // ==========================================
        // 3. DATOS GRÁFICA 3: CRECIMIENTO ANUAL CON ESPECIE
        // ==========================================
        const labelsCrecimiento = [];
        const datosPesoPromedio = [];

        @if (Model != null && Model.CrecimientoEspecie.Rows.Count > 0)
        {
            foreach (System.Data.DataRow row in Model.CrecimientoEspecie.Rows)
            {
                var tagAnio = $"{row["Anio"]} ({row["Especie"]})";
                <text>
                    labelsCrecimiento.push("@tagAnio");
                    datosPesoPromedio.push(@(row["PesoPromedio"] != DBNull.Value ? row["PesoPromedio"].ToString().Replace(',', '.') : "0"));
                </text>
            }
        }

        new Chart(document.getElementById('chartCrecimiento'), {
            type: 'line',
            data: {
                labels: labelsCrecimiento,
                datasets: [
                    { label: 'Peso Promedio (kg)', data: datosPesoPromedio, borderColor: '#ffc107', tension: 0.2 }
                ]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });


        // ==========================================
        // 4. DATOS GRÁFICA 4: ALIMENTACIÓN CON INVENTARIO Y ESPECIE
        // ==========================================
        const labelsAlimentacion = [];
        const datosAlimento = [];
        const datosPecesAlimentacion = [];

        @if (Model != null && Model.AlimentacionInventario.Rows.Count > 0)
        {
            foreach (System.Data.DataRow row in Model.AlimentacionInventario.Rows)
            {
                var fStr = row["Fecha"] != DBNull.Value ? Convert.ToDateTime(row["Fecha"]).ToString("dd/MM") : "";
                <text>
                    labelsAlimentacion.push("@fStr (@row["Especie"])");
                    datosAlimento.push(@(row["TotalAlimento"] != DBNull.Value ? row["TotalAlimento"].ToString().Replace(',', '.') : "0"));
                    datosPecesAlimentacion.push(@(row["TotalPeces"] != DBNull.Value ? row["TotalPeces"].ToString().Replace(',', '.') : "0"));
                </text>
            }
        }

        new Chart(document.getElementById('chartAlimentacion'), {
            type: 'bar',
            data: {
                labels: labelsAlimentacion,
                datasets: [
                    { label: 'Alimento (kg)', data: datosAlimento, backgroundColor: '#fd7e14', yAxisID: 'y' },
                    { label: 'Total Peces', data: datosPecesAlimentacion, borderColor: '#6f42c1', type: 'line', yAxisID: 'y1' }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { type: 'linear', position: 'left' },
                    y1: { type: 'linear', position: 'right', grid: { drawOnChartArea: false } }
                }
            }
        });

    });
</script>