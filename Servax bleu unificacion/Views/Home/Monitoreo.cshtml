@model System.Data.DataTable
@{
    ViewBag.Title = "Monitoreo de Calidad";
}

@section Styles {
    <link rel="stylesheet" href="~/Content/calidad.css">
    <style>
        /* Panel Glassmorphism Azul */
        .glass-blue-panel {
            background: rgba(14, 165, 233, 0.08) !important;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(14, 165, 233, 0.2) !important;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05) !important;
        }

        /* Encabezado del panel */
        .glass-blue-header {
            background: rgba(14, 165, 233, 0.15) !important;
            border-bottom: 1px solid rgba(14, 165, 233, 0.2) !important;
        }

        /* Ajustes de Glassmorphism para modo oscuro */
        [data-bs-theme="dark"] .glass-blue-panel {
            background: rgba(14, 165, 233, 0.05) !important;
            border: 1px solid rgba(14, 165, 233, 0.15) !important;
        }

        [data-bs-theme="dark"] .glass-blue-header {
            background: rgba(14, 165, 233, 0.1) !important;
            border-bottom: 1px solid rgba(14, 165, 233, 0.15) !important;
        }

        /* Tabla transparente adaptada al cristal */
        .glass-table {
            --bs-table-bg: transparent;
            --bs-table-color: inherit;
        }

            .glass-table thead th {
                background: rgba(14, 165, 233, 0.1) !important;
                color: var(--bs-body-color);
                border-bottom: 2px solid rgba(14, 165, 233, 0.2) !important;
                font-weight: 600;
            }

            .glass-table tbody tr {
                transition: background-color 0.2s ease;
            }

                .glass-table tbody tr:hover {
                    background: rgba(14, 165, 233, 0.1) !important;
                }

            .glass-table td {
                border: none !important;
                border-bottom: 1px solid rgba(14, 165, 233, 0.1) !important;
            }
    </style>
}

<div class="container-fluid px-4 mt-4">
    <div class="row g-4">

        <!-- COLUMNA IZQUIERDA: DASHBOARD Y DATOS -->
        <div class="col-lg-8">

            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4">
                    <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Selector de Rango de Fechas (Glassmorphism) -->
            <div class="card border-0 mb-4 glass-blue-panel rounded-4">
                <div class="card-body p-4">
                    @using (Html.BeginForm("Monitoreo", "Home", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
                    {
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-secondary mb-1">Fecha Inicio</label>
                            <input type="date" name="fechaInicio" class="form-control" value="@ViewBag.FechaInicio" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-secondary mb-1">Fecha Fin</label>
                            <input type="date" name="fechaFin" class="form-control" value="@ViewBag.FechaFin" />
                        </div>
                        <div class="col-md-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary w-100 shadow-sm">
                                <i class="fa-solid fa-filter me-1"></i> Filtrar
                            </button>
                            <a href="@Url.Action("Monitoreo", "Home")" class="btn btn-outline-secondary" title="Limpiar filtro">
                                <i class="fa-solid fa-rotate-left"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Canvas de la Gráfica Interactiva -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="fw-bold mb-0"><i class="fa-solid fa-chart-line text-info me-2"></i>Gráfica Comparativa de Parámetros</h5>
                    <span class="badge bg-info text-dark" id="lblTotalRegistros">0 lecturas</span>
                </div>
                <div class="card-body">
                    <div class="sv-chart-container">
                        <canvas id="graficaCalidad"></canvas>
                    </div>
                </div>
            </div>

            <!-- Tabla con datos (Glassmorphism) -->
            <div class="card border-0 mb-4 glass-blue-panel rounded-4 overflow-hidden">
                <div class="card-header d-flex justify-content-between align-items-center glass-blue-header py-3 border-0">
                    <h5 class="mb-0 fw-bold text-primary"><i class="fa-solid fa-table me-2"></i>Registros Guardados</h5>
                    <button type="button" id="btnAbrirImportar" class="sv-upload-trigger">
                        <i class="fa-solid fa-file-excel"></i> Importar Excel
                    </button>
                </div>
                <div class="card-body p-0">
                    <table class="table mb-0 glass-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Fecha</th>
                                <th>Temperatura (°C)</th>
                                <th>Oxígeno (mg/L)</th>
                                <th>Profundidad (m)</th>
                            </tr>
                        </thead>
                        <tbody id="tablaBody">
                            @if (Model != null && Model.Rows.Count > 0)
                            {
                                foreach (System.Data.DataRow row in Model.Rows)
                                {
                                    <tr>
                                        <td>@row["id"]</td>
                                        <td>@(row["Fecha"] != DBNull.Value ? Convert.ToDateTime(row["Fecha"]).ToString("dd/MM/yyyy") : "-")</td>
                                        <td>@row["Temperatura"]</td>
                                        <td>@row["Oxigeno"]</td>
                                        <td>@row["Profundidad"]</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        No se encontraron registros para el rango seleccionado.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

        <!-- COLUMNA DERECHA: ASISTENTE DE DATOS (estilo Apple) -->
        <div class="col-lg-4">
            <div class="sv-panel sticky-top sv-panel-sticky">

                <!-- Encabezado minimal -->
                <div class="sv-panel-header">
                    <span class="sv-eyebrow">Asistente de datos</span>
                    <h6 class="sv-title">Consulta natural</h6>
                    <p class="sv-subtitle">Describe lo que buscas y el panel se actualiza al instante.</p>
                </div>

                <!-- Campo de consulta estilo Spotlight -->
                <div class="sv-searchbar">
                    <i class="fa-solid fa-sparkles sv-searchbar-icon"></i>
                    <input type="text" id="copilotInput" class="sv-searchbar-input" placeholder="Ej. Muestra las lecturas de hoy" autocomplete="off" />
                    <button type="button" id="btnEnviarCopilot" class="sv-searchbar-btn" aria-label="Enviar consulta" disabled>
                        <i class="fa-solid fa-arrow-up"></i>
                    </button>
                </div>

                <!-- Sugerencias rápidas -->
                <div class="sv-chips" id="copilotChips">
                    <button type="button" class="sv-chip" data-query="Muestra las lecturas de hoy">Lecturas de hoy</button>
                    <button type="button" class="sv-chip" data-query="Temperaturas superiores a 21°C">Temp &gt; 21°C</button>
                    <button type="button" class="sv-chip" data-query="Oxígeno menor a 5">Oxígeno &lt; 5</button>
                </div>

                <!-- Ficha de resultado -->
                <div id="copilotResultado" class="sv-result-empty">
                    <i class="fa-regular fa-comment-dots"></i>
                    <p>Aún no has hecho ninguna consulta.</p>
                </div>

                <!-- Historial reciente -->
                <div id="copilotHistorial" class="sv-history"></div>

            </div>
        </div>

    </div>
</div>

<!-- Modal de importación (estilo Google Drive) -->
<div id="uploadModalOverlay" class="sv-modal-overlay" hidden>
    <div class="sv-modal" role="dialog" aria-modal="true" aria-labelledby="uploadModalTitle">
        <div class="sv-modal-header">
            <h5 id="uploadModalTitle" class="sv-modal-title">Importar lecturas desde Excel</h5>
            <button type="button" id="btnCerrarImportar" class="sv-modal-close" aria-label="Cerrar">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        @using (Html.BeginForm("CargarExcel", "Home", FormMethod.Post, new { enctype = "multipart/form-data", id = "uploadForm" }))
        {
            <div id="dropZone" class="sv-dropzone">
                <div class="sv-dropzone-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
                <p class="sv-dropzone-title">Arrastra tu archivo aquí</p>
                <p class="sv-dropzone-subtitle">o haz clic para buscarlo en tu equipo &middot; .xlsx, .xls</p>
                <input type="file" id="archivoExcel" name="archivoExcel" accept=".xlsx, .xls" class="d-none" />
            </div>

            <div id="fileInfo" class="sv-file-row d-none">
                <div class="sv-file-info">
                    <i class="fa-solid fa-file-excel"></i>
                    <span id="fileName"></span>
                </div>
                <div class="sv-file-actions">
                    <button type="button" id="btnQuitarArchivo" class="sv-btn-ghost">Quitar</button>
                    <button type="submit" class="sv-btn-primary">Guardar en SQL</button>
                </div>
            </div>
        }
    </div>
</div>


<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    let miGrafica = null;

    document.addEventListener("DOMContentLoaded", function () {
        // 1. Extraer datos iniciales del modelo C#
        const labels = [];
        const tempValues = [];
        const oxiValues = [];
        const profValues = [];

        @if (Model != null && Model.Rows.Count > 0)
        {
            foreach (System.Data.DataRow row in Model.Rows)
            {
                var fStr = row["Fecha"] != DBNull.Value ? Convert.ToDateTime(row["Fecha"]).ToString("dd/MM/yyyy") : "";
                <text>
                    labels.push("@fStr");
                    tempValues.push(@(row["Temperatura"] != DBNull.Value ? row["Temperatura"].ToString().Replace(',', '.') : "0"));
                    oxiValues.push(@(row["Oxigeno"] != DBNull.Value ? row["Oxigeno"].ToString().Replace(',', '.') : "0"));
                    profValues.push(@(row["Profundidad"] != DBNull.Value ? row["Profundidad"].ToString().Replace(',', '.') : "0"));
                </text>
            }
        }

        renderizarGrafica(labels, tempValues, oxiValues, profValues);

        // 2. Eventos del Asistente de datos
        const copilotInput = document.getElementById('copilotInput');
        const btnEnviarCopilot = document.getElementById('btnEnviarCopilot');

        copilotInput.addEventListener('input', function () {
            btnEnviarCopilot.disabled = copilotInput.value.trim().length === 0;
        });

        btnEnviarCopilot.addEventListener('click', enviarPreguntaCopilot);
        copilotInput.addEventListener('keypress', function (e) {
            if (e.key === 'Enter' && !btnEnviarCopilot.disabled) enviarPreguntaCopilot();
        });

        document.getElementById('copilotChips').addEventListener('click', function (e) {
            const chip = e.target.closest('.sv-chip');
            if (!chip) return;
            copilotInput.value = chip.dataset.query;
            btnEnviarCopilot.disabled = false;
            enviarPreguntaCopilot();
        });

        // 3. Modal de importación (estilo Google Drive) + Drag & Drop
        const overlay = document.getElementById("uploadModalOverlay");
        const btnAbrirImportar = document.getElementById("btnAbrirImportar");
        const btnCerrarImportar = document.getElementById("btnCerrarImportar");
        const btnQuitarArchivo = document.getElementById("btnQuitarArchivo");
        const dropZone = document.getElementById("dropZone");
        const fileInput = document.getElementById("archivoExcel");
        const fileInfo = document.getElementById("fileInfo");
        const fileName = document.getElementById("fileName");

        function abrirModalImportar() {
            overlay.hidden = false;
            document.body.style.overflow = "hidden";
        }

        function cerrarModalImportar() {
            overlay.hidden = true;
            document.body.style.overflow = "";
        }

        function mostrarArchivoSeleccionado(archivo) {
            fileName.textContent = archivo.name;
            fileInfo.classList.remove("d-none");
            dropZone.classList.add("d-none");
        }

        function limpiarArchivoSeleccionado() {
            fileInput.value = "";
            fileInfo.classList.add("d-none");
            dropZone.classList.remove("d-none");
        }

        btnAbrirImportar.addEventListener("click", abrirModalImportar);
        btnCerrarImportar.addEventListener("click", cerrarModalImportar);
        btnQuitarArchivo.addEventListener("click", limpiarArchivoSeleccionado);

        // Cerrar al hacer clic fuera de la tarjeta o con Escape
        overlay.addEventListener("click", (e) => {
            if (e.target === overlay) cerrarModalImportar();
        });
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && !overlay.hidden) cerrarModalImportar();
        });

        dropZone.addEventListener("click", () => fileInput.click());
        fileInput.addEventListener("change", () => {
            if (fileInput.files.length > 0) mostrarArchivoSeleccionado(fileInput.files[0]);
        });

        ["dragenter", "dragover"].forEach(evt =>
            dropZone.addEventListener(evt, (e) => {
                e.preventDefault();
                dropZone.classList.add("sv-dragover");
            })
        );
        ["dragleave", "drop"].forEach(evt =>
            dropZone.addEventListener(evt, (e) => {
                e.preventDefault();
                dropZone.classList.remove("sv-dragover");
            })
        );
        dropZone.addEventListener("drop", (e) => {
            const archivos = e.dataTransfer.files;
            if (archivos.length > 0) {
                fileInput.files = archivos;
                mostrarArchivoSeleccionado(archivos[0]);
            }
        });
    });

    function renderizarGrafica(labels, temp, oxi, prof) {
        const ctx = document.getElementById('graficaCalidad').getContext('2d');

        if (miGrafica) {
            miGrafica.destroy();
        }

        miGrafica = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    { label: 'Temperatura (°C)', data: temp, borderColor: '#dc3545', backgroundColor: 'rgba(220, 53, 69, 0.1)', borderWidth: 2, tension: 0.3, fill: true },
                    { label: 'Oxígeno (mg/L)', data: oxi, borderColor: '#0d6efd', backgroundColor: 'rgba(13, 110, 253, 0.1)', borderWidth: 2, tension: 0.3, fill: true },
                    { label: 'Profundidad (m)', data: prof, borderColor: '#ffc107', backgroundColor: 'rgba(255, 193, 7, 0.1)', borderWidth: 2, tension: 0.3, fill: true }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'top' } }
            }
        });

        document.getElementById('lblTotalRegistros').textContent = labels.length + " lecturas";
    }

    let historialConsultas = [];

    function enviarPreguntaCopilot() {
        const input = document.getElementById('copilotInput');
        const btn = document.getElementById('btnEnviarCopilot');
        const mensaje = input.value.trim();
        if (!mensaje) return;

        input.value = "";
        btn.disabled = true;
        btn.classList.add('sv-loading');
        btn.innerHTML = '<i class="fa-solid fa-circle-notch"></i>';

        // Llamada AJAX al método ConsultarAsistente en HomeController
        fetch('@Url.Action("ConsultarAsistente", "Home")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'mensaje=' + encodeURIComponent(mensaje)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                mostrarFichaResultado(mensaje, true, data.datos ? data.datos.length : 0, data.respuesta);
                actualizarInterfazCompleta(data.datos);
            } else {
                mostrarFichaResultado(mensaje, false, 0, data.respuesta);
            }
        })
        .catch(error => {
            mostrarFichaResultado(mensaje, false, 0, "Error al comunicarse con el servidor: " + error);
        })
        .finally(() => {
            btn.classList.remove('sv-loading');
            btn.innerHTML = '<i class="fa-solid fa-arrow-up"></i>';
        });
    }

    function mostrarFichaResultado(consulta, exito, totalRegistros, detalleTecnico) {
        const contenedor = document.getElementById('copilotResultado');

        // Extraer el SQL entre backticks si viene incluido, sin mostrarlo como mensaje de chat
        let sql = null;
        const match = detalleTecnico && detalleTecnico.match(/`([^`]+)`/);
        if (match) sql = match[1];

        if (exito) {
            contenedor.innerHTML = `
                <div class="sv-card">
                    <div class="sv-card-status ok"><i class="fa-solid fa-circle-check"></i> Consulta procesada</div>
                    <div class="sv-card-query">"${escaparHtml(consulta)}"</div>
                    <div class="sv-card-stat">
                        <span class="num">${totalRegistros}</span>
                        <span class="label">${totalRegistros === 1 ? 'lectura encontrada' : 'lecturas encontradas'}</span>
                    </div>
                    ${sql ? `<details class="sv-details"><summary></summary><pre>${escaparHtml(sql)}</pre></details>` : ''}
                </div>
            `;
        } else {
            contenedor.innerHTML = `
                <div class="sv-card">
                    <div class="sv-card-status err"><i class="fa-solid fa-circle-exclamation"></i> No se pudo procesar</div>
                    <div class="sv-card-query">"${escaparHtml(consulta)}"</div>
                    <div class="sv-card-error">${escaparHtml(detalleTecnico || 'Ocurrió un error inesperado.')}</div>
                </div>
            `;
        }

        agregarAlHistorial(consulta, exito, totalRegistros);
    }

    function agregarAlHistorial(consulta, exito, totalRegistros) {
        historialConsultas.unshift({ consulta, exito, totalRegistros });
        historialConsultas = historialConsultas.slice(0, 4);

        const historial = document.getElementById('copilotHistorial');
        historial.innerHTML = historialConsultas.map(item => `
            <div class="sv-history-item">
                <span class="sv-history-query">${escaparHtml(item.consulta)}</span>
                <span class="sv-history-count">${item.exito ? item.totalRegistros : '—'}</span>
            </div>
        `).join('');
    }

    function escaparHtml(texto) {
        const div = document.createElement('div');
        div.textContent = texto ?? '';
        return div.innerHTML;
    }

    function actualizarInterfazCompleta(datos) {
        const labels = [];
        const temp = [];
        const oxi = [];
        const prof = [];
        const tbody = document.getElementById('tablaBody');
        tbody.innerHTML = "";

        if (!datos || datos.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">No se encontraron registros para esta consulta.</td></tr>';
            renderizarGrafica([], [], [], []);
            return;
        }

        datos.forEach(item => {
            labels.push(item.Fecha);
            temp.push(item.Temperatura);
            oxi.push(item.Oxigeno);
            prof.push(item.Profundidad);

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${item.id}</td>
                <td>${item.Fecha}</td>
                <td>${item.Temperatura}</td>
                <td>${item.Oxigeno}</td>
                <td>${item.Profundidad}</td>
            `;
            tbody.appendChild(tr);
        });

        // Re-renderizar gráfica dinámicamente con los datos de Gemini
        renderizarGrafica(labels, temp, oxi, prof);
    }
</script>