@model Servax_bleu_unificacion.Models.MuestreoAbiotico
@{
    ViewBag.Title = "Eliminar Muestreo Abiótico";
}

<div class="container-fluid px-4 mt-4">
    <h4 class="fw-bold mb-4 text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>Eliminar Muestreo Abiótico</h4>

    <div class="card shadow-sm border-0" style="max-width: 700px;">
        <div class="card-body p-4">
            <p class="mb-2">
                ¿Seguro que quieres eliminar el muestreo del sitio <strong>@Model.NombreSitio</strong>
                del <strong>@Model.Fecha.ToString("dd/MM/yyyy")</strong> (turno <strong>@Model.Turno</strong>)?
            </p>
            <p class="text-muted small mb-4">Tambi&eacute;n se eliminar&aacute;n los valores de nutrientes de este muestreo. Esta acci&oacute;n no se puede deshacer.</p>

            @using (Html.BeginForm("Delete", "MuestreoAbiotico", new { id = Model.IdMuestreo }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger shadow-sm"><i class="fa-solid fa-trash me-1"></i> Sí, eliminar</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            }
        </div>
    </div>
</div>
