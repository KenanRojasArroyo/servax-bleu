@model List<Servax_bleu_unificacion.Models.MuestreoAbiotico>
@{
    ViewBag.Title = "Muestreos Abióticos";
    var nutrientes = new[] { "Nitritos", "Nitratos", "Silicatos", "Hierro", "Amonio", "Fosfatos" };
}

<div class="container-fluid px-4 mt-4">

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h4 class="fw-bold mb-0"><i class="fa-solid fa-flask text-primary me-2"></i>Muestreos Abi&oacute;ticos por Sitio</h4>
        <a href="@Url.Action("Create")" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Nuevo Muestreo
        </a>
    </div>

    <!-- Filtro por sitio -->
    <form method="get" class="row g-2 mb-3">
        <div class="col-auto">
            <select name="idSitio" class="form-select" onchange="this.form.submit()">
                <option value="">Todos los sitios</option>
                @foreach (var s in (List<SelectListItem>)ViewBag.Sitios)
                {
                    <option value="@s.Value" selected="@(ViewBag.IdSitioFiltro != null && ViewBag.IdSitioFiltro.ToString() == s.Value)">@s.Text</option>
                }
            </select>
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Sitio</th>
                        <th>Fecha</th>
                        <th>Turno</th>
                        <th>Ox&iacute;geno (mg/L)</th>
                        <th>Turbidez (m)</th>
                        @foreach (var n in nutrientes)
                        {
                            <th>@n</th>
                        }
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var m in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@m.NombreSitio</td>
                                <td>@m.Fecha.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-secondary">@m.Turno</span></td>
                                <td>@(m.OxigenoDisueltoMgL.HasValue ? m.OxigenoDisueltoMgL.Value.ToString("0.##") : "-")</td>
                                <td>@(m.TurbidezM.HasValue ? m.TurbidezM.Value.ToString("0.##") : "-")</td>
                                @foreach (var n in nutrientes)
                                {
                                    double? v = m.Nutrientes.ContainsKey(n) ? m.Nutrientes[n] : null;
                                    <td>@(v.HasValue ? v.Value.ToString("0.###") : "-")</td>
                                }
                                <td class="text-end text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(m.Observaciones))
                                    {
                                        <i class="fa-solid fa-comment-dots text-muted me-2" title="@m.Observaciones"></i>
                                    }
                                    <a href="@Url.Action("Edit", new { id = m.IdMuestreo })" class="btn btn-sm btn-outline-primary" title="Editar">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = m.IdMuestreo })" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="12" class="text-center text-muted py-4">No hay muestreos registrados todav&iacute;a.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
