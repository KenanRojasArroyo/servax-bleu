@model List<Servax_bleu_unificacion.Models.CrecimientoAnual>
@{
    ViewBag.Title = "Crecimiento Anual";
}

<div class="container-fluid px-4 mt-4">

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h4 class="fw-bold mb-0"><i class="fa-solid fa-chart-line text-primary me-2"></i>Crecimiento Anual</h4>
        <a href="@Url.Action("Create")" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Nuevo Registro
        </a>
    </div>

    <form method="get" class="row g-2 mb-3">
        <div class="col-auto">
            <select name="idCorral" class="form-select" onchange="this.form.submit()">
                <option value="">Todos los corrales</option>
                @foreach (var c in (List<SelectListItem>)ViewBag.Corrales)
                {
                    <option value="@c.Value" selected="@(ViewBag.IdCorralFiltro != null && ViewBag.IdCorralFiltro.ToString() == c.Value)">@c.Text</option>
                }
            </select>
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>A&ntilde;o</th>
                        <th>Corral</th>
                        <th>Especie</th>
                        <th>Peso Inicial (kg)</th>
                        <th>Peso Final (kg)</th>
                        <th>Tasa de Crecimiento (%)</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var ca in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@ca.Anio</td>
                                <td>@ca.NombreCorral</td>
                                <td>@ca.NombreEspecie</td>
                                <td>@(ca.PesoPromedioInicial?.ToString("N2") ?? "-")</td>
                                <td>@(ca.PesoPromedioFinal?.ToString("N2") ?? "-")</td>
                                <td>
                                    @if (ca.TasaCrecimiento != null)
                                    {
                                        <span class="badge bg-success">@ca.TasaCrecimiento.Value.ToString("N1")%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="@Url.Action("Edit", new { id = ca.IdCrecimiento })" class="btn btn-sm btn-outline-primary" title="Editar">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = ca.IdCrecimiento })" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No hay registros de crecimiento anual todav&iacute;a.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
