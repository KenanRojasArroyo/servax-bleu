@model Servax_bleu_unificacion.Models.CrecimientoAnual
@{
    ViewBag.Title = "Editar Registro de Crecimiento Anual";
}

<div class="container-fluid px-4 mt-4">
    <h4 class="fw-bold mb-4"><i class="fa-solid fa-pen text-primary me-2"></i>Editar Registro de Crecimiento Anual</h4>

    <div class="card shadow-sm border-0" style="max-width: 700px;">
        <div class="card-body p-4">
            @using (Html.BeginForm("Edit", "CrecimientoAnual", new { id = Model.IdCrecimiento }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IdCrecimiento)
                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Corral *</label>
                        @Html.DropDownListFor(m => m.IdCorral, (List<SelectListItem>)ViewBag.Corrales, new { @class = "form-select" })
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Especie *</label>
                        @Html.DropDownListFor(m => m.IdEspecie, (List<SelectListItem>)ViewBag.Especies, new { @class = "form-select" })
                    </div>
                </div>
                <div class="mb-3" style="max-width: 200px;">
                    <label class="form-label fw-bold">A&ntilde;o *</label>
                    @Html.TextBoxFor(m => m.Anio, new { @class = "form-control", type = "number" })
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Peso Promedio Inicial (kg)</label>
                        @Html.TextBoxFor(m => m.PesoPromedioInicial, new { @class = "form-control", type = "number", step = "0.01" })
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Peso Promedio Final (kg)</label>
                        @Html.TextBoxFor(m => m.PesoPromedioFinal, new { @class = "form-control", type = "number", step = "0.01" })
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Tasa de Crecimiento (%)</label>
                    @Html.TextBoxFor(m => m.TasaCrecimiento, new { @class = "form-control", type = "number", step = "0.01" })
                    <div class="form-text">Si lo dejas vacío y capturaste ambos pesos, se recalcula sola al guardar.</div>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold">Observaciones</label>
                    @Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control", rows = 2 })
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary shadow-sm"><i class="fa-solid fa-floppy-disk me-1"></i> Guardar Cambios</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            }
        </div>
    </div>
</div>
