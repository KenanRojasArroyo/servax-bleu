@model Servax_bleu_unificacion.Models.Especie
@{
    ViewBag.Title = "Nueva Especie";
}

<div class="container-fluid px-4 mt-4">
    <h4 class="fw-bold mb-4"><i class="fa-solid fa-plus text-primary me-2"></i>Nueva Especie</h4>

    <div class="card shadow-sm border-0" style="max-width: 700px;">
        <div class="card-body p-4">
            @using (Html.BeginForm("Create", "Especie", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                <div class="mb-3">
                    <label class="form-label fw-bold">Nombre *</label>
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Nombre Científico</label>
                    @Html.TextBoxFor(m => m.NombreCientifico, new { @class = "form-control" })
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Tipo</label>
                    @Html.TextBoxFor(m => m.Tipo, new { @class = "form-control", placeholder = "Ej. Atún aleta azul, Atún aleta amarilla..." })
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Descripción</label>
                    @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 3 })
                </div>
                <div class="form-check mb-2">
                    @Html.CheckBoxFor(m => m.EsToxica, new { @class = "form-check-input" })
                    <label class="form-check-label fw-bold text-danger">
                        <i class="fa-solid fa-skull-crossbones me-1"></i>Es tóxica (dispara alertas)
                    </label>
                </div>
                <div class="form-check mb-4">
                    @Html.CheckBoxFor(m => m.Activo, new { @class = "form-check-input" })
                    <label class="form-check-label fw-bold">Activa</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary shadow-sm">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Guardar
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            }
        </div>
    </div>
</div>
