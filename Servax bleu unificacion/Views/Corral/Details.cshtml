@model Servax_bleu_unificacion.Models.Corral
@{
    ViewBag.Title = "Detalle del Corral";
}

<div class="container-fluid px-4 mt-4">
    <h4 class="fw-bold mb-4"><i class="fa-solid fa-eye text-primary me-2"></i>Detalle del Corral</h4>

    <div class="card shadow-sm border-0" style="max-width: 700px;">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Model.Nombre</dd>

                <dt class="col-sm-4">Ubicación</dt>
                <dd class="col-sm-8">@(Model.Ubicacion ?? "-")</dd>

                <dt class="col-sm-4">Capacidad Máxima</dt>
                <dd class="col-sm-8">@(Model.CapacidadMaxima?.ToString("N2") ?? "-")</dd>

                <dt class="col-sm-4">Fecha de Instalación</dt>
                <dd class="col-sm-8">@(Model.FechaInstalacion?.ToString("dd/MM/yyyy") ?? "-")</dd>

                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8">@(Model.Estado ?? "-")</dd>

                <dt class="col-sm-4">Observaciones</dt>
                <dd class="col-sm-8">@(Model.Observaciones ?? "-")</dd>
            </dl>

            <div class="d-flex gap-2 mt-3">
                <a href="@Url.Action("Edit", new { id = Model.IdCorral })" class="btn btn-primary">
                    <i class="fa-solid fa-pen me-1"></i> Editar
                </a>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Volver al listado</a>
            </div>
        </div>
    </div>
</div>
